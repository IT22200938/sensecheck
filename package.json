{
  "name": "sensecheck",
  "version": "1.0.0",
  "description": "Sensecheck Facility - Interactive Digital Research Lab for Sensory and Cognitive Assessment",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "start": "cd server && npm start",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "build:all": "npm run build && echo Build complete",
    "vercel-build": "cd client && npm install && npm run build"
  },
  "keywords": ["game", "assessment", "mern", "konva", "react"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^8.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

